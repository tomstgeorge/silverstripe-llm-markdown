{
    "name": "tomstgeorge/silverstripe-llm-markdown",
    "description": "Generates llm.txt and Markdown versions of pages for AI agents, building on staticpublishqueue.",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "CMS", "static", "markdown", "llm", "AI"],
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silverstripe/cms": "^6.0",
        "silverstripe/staticpublishqueue": "^7.0",
        "league/html-to-markdown": "^5.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.7",
        "silverstripe/standards": "^1",
        "phpstan/extension-installer": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "TomStGeorge\\LLMMarkdown\\": "src/",
            "TomStGeorge\\LLMMarkdown\\Tests\\": "tests/php/"
        }
    },
    "extra": {
        "expose": ["client/dist"]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
